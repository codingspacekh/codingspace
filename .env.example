# Copy to .env.local for development. Never commit real values.
# Public (shipped to the browser):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin for canonical links, sitemap and RSS. Leave empty until codingspace.io is live
# (Vercel's production domain is used instead).
NEXT_PUBLIC_SITE_URL=
# Server only:
SUPABASE_SERVICE_ROLE_KEY=
# Launch switch (M7): true removes noindex and opens robots.txt.
SITE_INDEXABLE=false

# Media (M4): Cloudflare R2. See README "Media (R2)".
# Public address of the bucket: https://pub-….r2.dev until files.codingspace.io is set up.
NEXT_PUBLIC_MEDIA_BASE_URL=
# Server only:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Without R2: keep uploads in ./.media-local (this machine only) by uncommenting both lines.
# MEDIA_STORE=local
# NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3000/api/media-local
