# Copy to .env.local for development. Never commit real values.
# Public (shipped to the browser):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin for canonical links, sitemap and RSS. Leave empty until codingspace.io is live
# (Vercel's production domain is used instead).
NEXT_PUBLIC_SITE_URL=
# Server only:
SUPABASE_SERVICE_ROLE_KEY=
# Launch switch (M7): true removes noindex and opens robots.txt.
SITE_INDEXABLE=false
