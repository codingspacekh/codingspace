{
  "name": "codingspace",
  "private": true,
  "version": "0.1.0",
  "description": "codingspace.io: lessons in competition maths, physics, coding and IT",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "node patches/apply-arwes-patch.mjs",
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prebuild": "node patches/apply-arwes-patch.mjs",
    "pretest": "node patches/apply-arwes-patch.mjs",
    "audit:ci": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@arwes/react": "1.0.0-next.25020502",
    "@supabase/supabase-js": "2.117.2",
    "motion": "10.18.0",
    "next": "16.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.6",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "msw": "2.15.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
